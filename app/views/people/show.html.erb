<h1 class="display-4 text-primary">Person Details</h1>
<p class="lead"><%= @msg %></p>
<table class="table table-striped">
  <tbody>
    <tr>
      <th scope="row">ID</th>
      <td><%= @person.id %></td>
    </tr>
    <tr>
      <th scope="row">Name</th>
      <td><%= @person.name %></td>
    </tr>
    <tr>
      <th scope="row">Age</th>
      <td><%= @person.age %></td>
    </tr>
    <tr>
      <th scope="row">Mail</th>
      <td><%= @person.mail %></td>
    </tr>
  </tbody>
</table>
