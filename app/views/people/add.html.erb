<h1 class="display-4 text-primary">People#Add</h1>
<p class="lead"><%= @msg %></p>
<%= form_with model: @person, url: create_person_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :age, class: "form-label" %>
    <%= f.number_field :age, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :mail, class: "form-label" %>
    <%= f.email_field :mail, class: "form-control" %>
  </div>
  <%= f.submit "Add Person", class: "btn btn-primary" %>
<% end %>