<h1 class="display-4 text-primary">People#index</h1>
<p class="lead"><%= @msg %></p>
<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Name</th>
      <th scope="col">Age</th>
      <th scope="col">Mail</th>
    </tr>
  </thead>
  <tbody>
    <% @data.each do |person| %>
      <tr>
        <th scope="row"><%= person.id %></th>
        <td><%= person.name %></td>
        <td><%= person.age %></td>
        <td><%= person.mail %></td>
      </tr>
    <% end %>
  </tbody>
</table>
